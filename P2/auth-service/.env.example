# Servidor
PORT=4000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=practica2_auth
DB_USER=root
DB_PASSWORD=tu_password_aqui

# JWT
JWT_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN_SECONDS=900
JWT_RENEW_GRACE_PERIOD_SECONDS=300

# Encriptacion AES (debe ser una cadena de 32 caracteres para AES-256)
AES_SECRET_KEY=cambia_esto_32_caracteres_exactos

# Microservicio de autorizacion
AUTHZ_SERVICE_URL=http://localhost:4001
AUTHZ_MAX_RETRIES=3
AUTHZ_RETRY_BACKOFF_MS=500
AUTHZ_TIMEOUT_MS=2000

# Cookies
COOKIE_SECURE=false

# Frontend (para configurar CORS con credenciales)
FRONTEND_URL=http://localhost:5173